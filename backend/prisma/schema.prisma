generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SystemRole {
  SYSTEM_ADMIN
  BUSINESS_USER
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum ModuleKey {
  POS
  INVENTORY
  FINANCE
  OPERATIONS
  REPORTS
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  PHYSICAL
  SERVICE
  FEE
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockAdjustmentType {
  SET
  INCREASE
  DECREASE
}

enum POSMode {
  RETAIL_CHECKOUT
  TABLE_SERVICE
}
enum POSTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  INACTIVE
}

enum POSOrderStatus {
  OPEN
  BILL_PRINTED
  PAID
  CANCELLED
}

enum POSOrderItemStatus {
  ACTIVE
  CANCELLED
}

model User {
  salaryProfiles SalaryProfile[]
  moneyPostings MoneyPosting[]
  cashCounts CashCount[]
  purchaseReceipts PurchaseReceipt[]
  purchasesCreated PurchaseOrder[] @relation("PurchasesCreated")
  purchasesApproved PurchaseOrder[] @relation("PurchasesApproved")
  purchasesReceived PurchaseOrder[] @relation("PurchasesReceived")

  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  systemRole   SystemRole @default(BUSINESS_USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships BusinessUser[]
  sales        Sale[]
  posOrders    POSOrder[]
  recordedExpenses Expense[] @relation("RecordedExpenses")
  approvedExpenses Expense[] @relation("ApprovedExpenses")
  stockAdjustments StockAdjustment[]
}

model Business {
  salaryProfiles SalaryProfile[]
  payrollEntries PayrollEntry[]
  financeEvents FinanceEvent[]
  moneyAccounts MoneyAccount[]
  moneyPostings MoneyPosting[]
  stockRequests StockRequest[]
  cashCounts CashCount[]
  installerBuilds InstallerBuild[]
  installations Installation[]
  installationEnrollments InstallationEnrollment[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]

  id        String         @id @default(cuid())
  name      String
  type      String?
  posMode   POSMode        @default(RETAIL_CHECKOUT)
  country   String?
  currency  String         @default("UGX")
  logoUrl   String?
  brandPrimaryColor   String?
  brandSecondaryColor String?
  useBrandTheme Boolean @default(false)
  contactPhone        String?
  contactEmail        String?
  address             String?
  receiptHeader       String?
  receiptFooter       String?
  taxName             String         @default("VAT")
  taxRate             Float          @default(0)
  taxEnabled          Boolean        @default(false)
  status    BusinessStatus @default(ACTIVE)
  platformBusinessTypeId String?
  platformPackageId      String?
  packageStatus          String         @default("ACTIVE")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tables    POSTable[]

  platformBusinessType PlatformBusinessType? @relation(fields: [platformBusinessTypeId], references: [id], onDelete: SetNull)
  platformPackage      PlatformPackage?      @relation(fields: [platformPackageId], references: [id], onDelete: SetNull)
  branches    Branch[]
  customers   Customer[]
  memberships BusinessUser[]
  modules     BusinessModule[]
  products    Product[]
  roles       Role[]
  sales       Sale[]
  expenses    Expense[]
  posOrders   POSOrder[]
  inventoryStocks InventoryStock[]
  stockAdjustments StockAdjustment[]

  @@index([platformBusinessTypeId])
  @@index([platformPackageId])
}

model InstallationEnrollment {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  codeHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  installation Installation?
}

model Installation {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enrollmentId String @unique
  enrollment InstallationEnrollment @relation(fields: [enrollmentId], references: [id])
  tokenHash String @unique
  name String
  platform String
  architecture String
  appVersion String
  mode String @default("DESKTOP")
  healthy Boolean @default(false)
  createdAt DateTime @default(now())
  lastSeenAt DateTime?
  revokedAt DateTime?
  @@index([businessId, createdAt])
}

model InstallerBuild {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform String
  architecture String
  appVersion String
  status String @default("QUEUED")
  configHash String
  manifest Json
  fileName String?
  sha256 String?
  byteSize Int?
  error String?
  createdById String
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  @@index([businessId, createdAt])
  @@index([status, createdAt])
}

model PlatformBusinessType {
  id                String   @id @default(cuid())
  key               String   @unique
  value             String   @unique
  label             String
  posMode           POSMode  @default(RETAIL_CHECKOUT)
  helper            String?
  defaultTableCount Int?
  defaultModuleKeys Json
  roles             Json
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  businesses Business[]
}

model PlatformPackage {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("UGX")
  billingCycle String  @default("MONTHLY")
  maxBranches Int?
  maxUsers    Int?
  maxProducts Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules    PlatformPackageModule[]
  businesses Business[]
}

model PlatformPackageModule {
  id        String    @id @default(cuid())
  packageId String
  moduleKey ModuleKey
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  package PlatformPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, moduleKey])
  @@index([packageId])
}

model Branch {
  salaryProfiles SalaryProfile[]
  moneyAccounts MoneyAccount[]
  cashCounts CashCount[]
  purchaseOrders PurchaseOrder[]

  id         String       @id @default(cuid())
  name       String
  location   String?
  status     BranchStatus @default(ACTIVE)
  businessId String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tables   POSTable[]

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales    Sale[]
  expenses Expense[]
  posOrders POSOrder[]
  inventoryStocks InventoryStock[]
  stockAdjustments StockAdjustment[]

  @@index([businessId])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  businessId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships BusinessUser[]

  @@unique([businessId, name])
}

model BusinessUser {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  roleId     String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role     Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId])
}

model BusinessModule {
  id         String    @id @default(cuid())
  key        ModuleKey
  active     Boolean   @default(false)
  businessId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId])
}

model Product {
  privateCost ProductCost?
  minimumPrice Decimal @default(0) @db.Decimal(12, 2)
  purchaseOrderItems PurchaseOrderItem[]

  id         String        @id @default(cuid())
  name       String
  sku        String?
  barcode    String?
  type       ProductType   @default(PHYSICAL)
  category   String?
  unit       String?
  price      Decimal       @db.Decimal(12, 2)
  status     ProductStatus @default(ACTIVE)
  businessId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]
  posOrderItems POSOrderItem[]
  inventoryStocks InventoryStock[]
  stockAdjustments StockAdjustment[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
}

model Sale {
  id            String        @id @default(cuid())
  requestKey    String?
  requestHash   String?
  receiptNumber String        @unique
  subtotal      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  businessId    String
  branchId      String
  cashierId     String
  customerId    String?
  tableId       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashier  User       @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table    POSTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  posOrder POSOrder?

  @@unique([businessId, requestKey])

  @@index([businessId])
  @@index([branchId])
  @@index([cashierId])
  @@index([customerId])
  @@index([tableId])
}

model Customer {
  id         String         @id @default(cuid())
  name       String
  phone      String?
  email      String?
  notes      String?
  status     CustomerStatus @default(ACTIVE)
  businessId String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales    Sale[]
  posOrders POSOrder[]

  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@index([businessId])
}

model MoneyAccount {
  id String @id @default(cuid())
  businessId String
  branchId String
  code String
  name String
  kind String
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  entries MoneyEntry[]
  @@unique([branchId, code])
  @@index([businessId])
}

model MoneyPosting {
  id String @id @default(cuid())
  businessId String
  branchId String
  requestKey String
  requestHash String
  kind String
  sourceId String?
  amount Decimal @db.Decimal(14, 2)
  note String
  recordedById String
  reversesId String? @unique
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recordedBy User @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  entries MoneyEntry[]
  @@unique([businessId, requestKey])
  @@index([businessId, branchId, createdAt])
  @@index([businessId, kind, sourceId])
}

model MoneyEntry {
  id String @id @default(cuid())
  postingId String
  accountId String
  amount Decimal @db.Decimal(14, 2)
  posting MoneyPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  account MoneyAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@unique([postingId, accountId])
  @@index([accountId])
}

model ProductCost {
  productId String @id
  amount Decimal? @db.Decimal(12, 2)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SaleItem {
  suggestedPrice Decimal? @db.Decimal(12, 2)
  minimumPrice Decimal? @db.Decimal(12, 2)
  id        String   @id @default(cuid())
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)
  saleId    String
  productId String
  createdAt DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model Expense {
  payrollEntry PayrollEntry?
  id          String        @id @default(cuid())
  title       String
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  note        String?
  status      ExpenseStatus @default(PENDING)
  businessId  String
  branchId    String
  recordedById String
  approvedById String?
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  recordedBy User     @relation("RecordedExpenses", fields: [recordedById], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("ApprovedExpenses", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([branchId])
  @@index([recordedById])
  @@index([approvedById])
  @@index([status])
  @@index([createdAt])
}

model InventoryStock {
  id           String   @id @default(cuid())
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  productId    String
  branchId     String
  businessId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([businessId])
  @@index([branchId])
}

model StockAdjustment {
  purchaseReceiptId String?
  purchaseReceipt PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  @@index([purchaseReceiptId])
  id             String              @id @default(cuid())
  type           StockAdjustmentType @default(SET)
  quantityBefore Int
  quantityChange Int
  quantityAfter  Int
  note           String?
  productId      String
  branchId       String
  businessId     String
  userId         String
  createdAt      DateTime            @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([branchId])
  @@index([productId])
  @@index([userId])
}

model POSTable {
  id         String         @id @default(cuid())
  name       String
  seats      Int            @default(4)
  status     POSTableStatus @default(AVAILABLE)
  businessId String
  branchId   String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales    Sale[]
  posOrders POSOrder[]

  @@unique([businessId, branchId, name])
  @@index([businessId])
  @@index([branchId])
}

model POSOrder {
  id          String         @id @default(cuid())
  orderNumber String        @unique
  subtotal    Decimal       @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  status      POSOrderStatus @default(OPEN)
  businessId  String
  branchId    String
  tableId     String
  waiterId    String
  customerId  String?
  saleId      String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table    POSTable  @relation(fields: [tableId], references: [id], onDelete: Restrict)
  waiter   User      @relation(fields: [waiterId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items    POSOrderItem[]

  @@index([businessId])
  @@index([branchId])
  @@index([tableId])
  @@index([waiterId])
  @@index([customerId])
  @@index([status])
}

model POSOrderItem {
  suggestedPrice Decimal? @db.Decimal(12, 2)
  minimumPrice Decimal? @db.Decimal(12, 2)
  id        String             @id @default(cuid())
  quantity  Int
  unitPrice Decimal            @db.Decimal(12, 2)
  lineTotal Decimal            @db.Decimal(12, 2)
  status    POSOrderItemStatus @default(ACTIVE)
  orderId   String
  productId String
  createdAt DateTime           @default(now())

  order   POSOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}


model SyncOperation {
  id            String   @id @default(cuid())
  businessId    String?
  branchId      String?
  entityType    String
  entityId      String?
  operation     String
  method        String
  endpoint      String
  payload       Json?
  status        String   @default("PENDING")
  source        String   @default("desktop")
  attempts      Int      @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  syncedAt      DateTime?
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId])
  @@index([branchId])
  @@index([status])
  @@index([entityType])
  @@index([createdAt])
}


enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}
model Supplier {
  id String @id @default(cuid())
  businessId String
  name String
  email String?
  phone String?
  address String?
  notes String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders PurchaseOrder[]
  @@index([businessId, active])
}
model PurchaseOrder {
  receipts PurchaseReceipt[]
  id String @id @default(cuid())
  number String @unique
  businessId String
  branchId String
  supplierId String
  createdById String
  approvedById String?
  receivedById String?
  status PurchaseOrderStatus @default(DRAFT)
  currency String
  total Decimal @db.Decimal(12, 2)
  note String?
  approvedAt DateTime?
  receivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User @relation("PurchasesCreated", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User? @relation("PurchasesApproved", fields: [approvedById], references: [id], onDelete: Restrict)
  receivedBy User? @relation("PurchasesReceived", fields: [receivedById], references: [id], onDelete: Restrict)
  items PurchaseOrderItem[]
  @@index([businessId, createdAt])
  @@index([branchId, status])
}
model PurchaseOrderItem {
  receivedQuantity Int @default(0)
  id String @id @default(cuid())
  orderId String
  productId String
  productName String
  quantity Int
  unitCost Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([orderId, productId])
  @@index([productId])
}

model PurchaseReceipt {
  id String @id @default(cuid())
  reference String @unique
  orderId String
  receivedById String?
  requestKey String?
  requestHash String?
  note String?
  items Json
  createdAt DateTime @default(now())
  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy User? @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  adjustments StockAdjustment[]
  @@unique([orderId, requestKey])
  @@index([orderId, createdAt])
}

model CashCount {
  id String @id @default(cuid())
  businessId String
  branchId String
  recordedById String
  requestKey String
  requestHash String
  date String
  periodStart DateTime
  periodEnd DateTime
  currency String
  opening Decimal @db.Decimal(14,2)
  cashIn Decimal @db.Decimal(14,2)
  cashOut Decimal @db.Decimal(14,2)
  cashSales Decimal @db.Decimal(14,2)
  expected Decimal @db.Decimal(14,2)
  counted Decimal @db.Decimal(14,2)
  difference Decimal @db.Decimal(14,2)
  note String?
  createdAt DateTime @default(now())
  business Business @relation(fields:[businessId],references:[id],onDelete:Restrict)
  branch Branch @relation(fields:[branchId],references:[id],onDelete:Restrict)
  recordedBy User @relation(fields:[recordedById],references:[id],onDelete:Restrict)
  @@unique([businessId,requestKey])
  @@index([businessId,branchId,date,createdAt])
}

model StockRequest {
  id String @id @default(cuid())
  businessId String
  requestKey String
  requestHash String
  response Json
  createdAt DateTime @default(now())
  business Business @relation(fields:[businessId],references:[id],onDelete:Restrict)
  @@unique([businessId,requestKey])
}

model SalaryProfile {
  id String @id @default(cuid())
  businessId String
  employeeId String
  branchId String
  monthlyAmount Decimal @db.Decimal(12,2)
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
  business Business @relation(fields:[businessId],references:[id],onDelete:Cascade)
  employee User @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  branch Branch @relation(fields:[branchId],references:[id],onDelete:Restrict)
  entries PayrollEntry[]
  @@unique([businessId,employeeId])
}
model PayrollEntry {
  id String @id @default(cuid())
  businessId String
  profileId String
  period String
  expenseId String @unique
  createdAt DateTime @default(now())
  business Business @relation(fields:[businessId],references:[id],onDelete:Cascade)
  profile SalaryProfile @relation(fields:[profileId],references:[id],onDelete:Restrict)
  expense Expense @relation(fields:[expenseId],references:[id],onDelete:Restrict)
  @@unique([profileId,period])
  @@index([businessId,period])
}
model FinanceEvent {
  id String @id @default(cuid())
  businessId String
  entityId String
  actorId String
  action String
  details Json
  createdAt DateTime @default(now())
  business Business @relation(fields:[businessId],references:[id],onDelete:Cascade)
  @@index([businessId,entityId,createdAt])
}
