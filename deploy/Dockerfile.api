FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY backend/package*.json ./
RUN npm ci
COPY backend/prisma ./prisma
RUN npm run prisma:generate
COPY backend/src ./src
COPY desktop/package.json /app/desktop/package.json
RUN mkdir -p /app/desktop/.installer-artifacts && chown -R node:node /app
USER node
ENV NODE_ENV=production HOST=0.0.0.0 PORT=5050 ZERA_INSTALLER_WORKER=false
EXPOSE 5050
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node src/server.js"]
